[station]
callsign = "N0CALL"
grid = "AA00"

[audio]
enabled = true
input_device = ""
output_device = ""
sample_rate_hz = 48000
channels = 1

[radio]
enabled = true
backend = "native"
endpoint = "127.0.0.1:4532" # Used by rigctld and DX Lab Commander backends
model = "IC-7300"
serial_port = "/dev/ttyUSB0"
baud_rate = 115200
civ_address = 148
controller_civ_address = 224

[server]
enabled = false
url = "https://radio.example.net"
device_token = "" # Secret issued by POST /api/v1/auth/device; prefer QSONAUT_SERVER_DEVICE_TOKEN
share_presence = false
share_radio_details = false
share_logs = false

[contest]
enabled = false
operating_mode = "Run" # Run | SearchAndPounce
split_policy = "Off"   # Off | Fake | Rig
fox_hound_role = "Disabled" # Disabled | Fox | Hound
exchange_template = ""
serial_start = 1
serial_step = 1
dupe_check = true
