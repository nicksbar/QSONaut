# QSONaut environment overrides
QSONAUT_STATION_CALLSIGN=N0CALL
QSONAUT_STATION_GRID=AA00

# Optional QSONaut Server connection. Every outbound data class is opt-in.
QSONAUT_SERVER_ENABLED=false
QSONAUT_SERVER_URL=https://radio.example.net
QSONAUT_SERVER_DEVICE_TOKEN=
QSONAUT_SERVER_SHARE_PRESENCE=false
QSONAUT_SERVER_SHARE_RADIO_DETAILS=false
QSONAUT_SERVER_SHARE_LOGS=false

# Automation may always observe server events and request snapshots. Publishing
# to shared server channels requires this explicit operator grant.
QSONAUT_AUTOMATION_ENABLE_SERVER_PUBLISH=false
QSONAUT_AUTOMATION_ENABLE_EXTERNAL_SEND=false

QSONAUT_AUDIO_ENABLED=true
QSONAUT_AUDIO_INPUT_DEVICE=
QSONAUT_AUDIO_OUTPUT_DEVICE=
QSONAUT_AUDIO_SAMPLE_RATE_HZ=48000
QSONAUT_AUDIO_CHANNELS=1

QSONAUT_RADIO_ENABLED=true
QSONAUT_RADIO_BACKEND=none
QSONAUT_RADIO_SERIAL_PORT=/dev/ttyUSB0
QSONAUT_RADIO_BAUD_RATE=115200
QSONAUT_RADIO_CIV_ADDRESS=0x94
QSONAUT_RADIO_CONTROLLER_CIV_ADDRESS=0xE0

# Reserved for future experiments; currently unused by active RX/TX workflows.

# WSLg: QSONaut uses the native Wayland path by default. Override per launch
# with WINIT_UNIX_BACKEND=x11 when testing X11 behavior.
# WINIT_UNIX_BACKEND=x11

# QSONaut lets eframe/WGPU select a surface-compatible adapter with a low-power
# default. Settings > Graphics can select another available GPU for this session.
# Set this only to override backend availability: vulkan, dx12, metal, gl.
# On WSLg, the automatic GL/D3D12 path is preferred because Vulkan may select
# llvmpipe (software rendering) when the WSL Vulkan layers are unavailable.
# WGPU_BACKEND=vulkan
# Optional standard WGPU power override: low, high, or none.
# WGPU_POWER_PREF=low
