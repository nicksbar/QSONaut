# RigForge environment overrides
RIGFORGE_STATION_CALLSIGN=N0CALL
RIGFORGE_STATION_GRID=AA00

RIGFORGE_AUDIO_ENABLED=true
RIGFORGE_AUDIO_INPUT_DEVICE=
RIGFORGE_AUDIO_OUTPUT_DEVICE=
RIGFORGE_AUDIO_SAMPLE_RATE_HZ=48000
RIGFORGE_AUDIO_CHANNELS=1

RIGFORGE_RADIO_ENABLED=true
RIGFORGE_RADIO_BACKEND=none
RIGFORGE_RADIO_SERIAL_PORT=/dev/ttyUSB0
RIGFORGE_RADIO_BAUD_RATE=115200
RIGFORGE_RADIO_CIV_ADDRESS=0x94
RIGFORGE_RADIO_CONTROLLER_CIV_ADDRESS=0xE0

RIGFORGE_AI_ENABLED=false
RIGFORGE_AI_PROVIDER=none
