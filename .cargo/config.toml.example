# Optional local development override.
# Copy this file to `.cargo/config.toml` when the RigForge sibling checkouts
# are available. The copied file is ignored by Git; CI and other users resolve
# the immutable Git dependencies declared in the package manifests.

[patch.crates-io]
rigwright = { path = "../rigwright" }

[patch."https://github.com/nicksbar/QSONaut-HostBridge.git"]
qsonaut-hostbridge-protocol = { path = "../QSONaut-HostBridge/crates/qsonaut-hostbridge-protocol" }

[patch."https://github.com/nicksbar/qsonaut-modems.git"]
qsonaut-modems = { path = "../qsonaut-modems/crates/qsonaut-modems" }


[patch."https://github.com/jl1nie/mfsk-core.git"]
mfsk-core = { path = "../mfsk-core/mfsk-core" }

[patch."https://github.com/swilcox/cw-dit.git"]
cwdit-dsp = { path = "../cw-dit/cwdit-dsp" }
cwdit-morse = { path = "../cw-dit/cwdit-morse" }
